# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ege_tasks
POSTGRES_PORT=5432
# max_connections должно быть >= UVICORN_WORKERS × (DB_POOL_SIZE + DB_MAX_OVERFLOW) + запас.
# Например: 4 × (20 + 10) = 120, плюс запас на backup и миграции — берём 200.
POSTGRES_MAX_CONNECTIONS=200

# API
API_PORT=8000
# Количество процессов uvicorn. Каждый воркер имеет собственный пул БД и семафор LLM.
# Реальный потолок параллельных LLM-вызовов = LLM_MAX_CONCURRENCY × UVICORN_WORKERS.
UVICORN_WORKERS=4

# Прочие порты
HTTP_PORT=80
HTTPS_PORT=443
PROMETHEUS_PORT=9090
LOKI_PORT=3100
GRAFANA_PORT=3000

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Backup
BACKUP_SCHEDULE="0 3 * * *"
BACKUP_RETENTION_DAYS=7
