# Параметры приложения (читает Pydantic Settings в backend/app/core/config.py).
# Инфраструктурные переменные docker-compose (POSTGRES_*, UVICORN_WORKERS,
# GRAFANA_*, BACKUP_* и т.п.) находятся в корневом .env.example.

# Подключение к БД (для локального запуска вне Docker)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ege_tasks

# LLM-провайдеры: "yandexgpt", "gigachat", "mock"
LLM_GENERATION_PROVIDER=mock
LLM_VALIDATION_PROVIDER=mock

# YandexGPT
YANDEXGPT_API_KEY=
YANDEXGPT_FOLDER_ID=

# GigaChat (Сбер)
# GIGACHAT_CREDENTIALS — Authorization Key (Base64 от ClientID:ClientSecret)
GIGACHAT_CREDENTIALS=
# GIGACHAT_SCOPE — GIGACHAT_API_PERS, GIGACHAT_API_B2B, GIGACHAT_API_CORP
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Модели и температуры (дефолты подставляются автоматически, если переменная
# не задана; пустое значение приведёт к ошибке парсинга, поэтому не оставляйте
# строки пустыми — либо задайте значение, либо закомментируйте).
GIGACHAT_GENERATION_MODEL=GigaChat-Pro
GIGACHAT_GENERATION_TEMPERATURE=0.7
GIGACHAT_VALIDATION_MODEL=GigaChat-Max
GIGACHAT_VALIDATION_TEMPERATURE=0.0

# Тарифы LLM (руб за 1000 токенов) для заполнения llm_calls.estimated_cost_rub.
# Если оставить нули — стоимость не считается (NULL в БД).
# Значения задайте под фактически используемую модель (GigaChat-Pro, -Max, YandexGPT Pro/Lite и т.п.)
YANDEXGPT_PRICE_RUB_PER_1K_PROMPT=0
YANDEXGPT_PRICE_RUB_PER_1K_COMPLETION=0
GIGACHAT_PRICE_RUB_PER_1K_PROMPT=0
GIGACHAT_PRICE_RUB_PER_1K_COMPLETION=0

# Прочее
# DEBUG=true только для локальной разработки (включает DEBUG-логи).
# В production-окружении ОБЯЗАТЕЛЬНО установите false.
DEBUG=true
MAX_RETRIES=3

# Защита от перегрузки LLM
# LLM_TIMEOUT_SECONDS — максимум секунд на одну попытку LLM-вызова
LLM_TIMEOUT_SECONDS=90
# LLM_MAX_CONCURRENCY — одновременных LLM-вызовов на один процесс uvicorn.
# Реальный потолок параллельных LLM = LLM_MAX_CONCURRENCY × UVICORN_WORKERS.
LLM_MAX_CONCURRENCY=8
# Количество попыток при транспортных сбоях (429/5xx); таймауты не ретраятся
LLM_RETRY_ATTEMPTS=3
LLM_RETRY_INITIAL_DELAY=1.0

# Пул соединений БД (на один процесс uvicorn)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
# Секунд ждать свободный слот в пуле; иначе ошибка
DB_POOL_TIMEOUT=5

# Rate limit на /generate (на IP в минуту, на процесс uvicorn)
RATE_LIMIT_PER_MINUTE=5
